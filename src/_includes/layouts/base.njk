<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{ title }}{% if title != "Panamensis" %} · Panamensis{% endif %}</title>
  <meta name="description" content="{{ description or site.description[lang] }}">
  <meta name="author" content="Edgardo Civallero">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#main">{{ "Skip to content" if lang == "en" else "Saltar al contenido" }}</a>
  <header class="site-header">
    <div class="header-inner wrap">
      <a class="brand" href="/{{ lang }}/" aria-label="{{ 'Panamensis home' if lang == 'en' else 'Inicio de Panamensis' }}"><img class="brand-mark" src="/assets/images/panamensis-mark.svg" alt=""><span>Panamensis</span></a>
      <nav class="primary-nav" aria-label="{{ 'Primary navigation' if lang == 'en' else 'Navegación principal' }}">
        {% for item in site.nav[lang] %}<a href="{{ item[1] }}">{{ item[0] }}</a>{% endfor %}
      </nav>
      <details class="menu"><summary>{{ "Menu" if lang == "en" else "Menú" }}</summary><nav aria-label="{{ 'Mobile navigation' if lang == 'en' else 'Navegación móvil' }}">{% for item in site.nav[lang] %}<a href="{{ item[1] }}">{{ item[0] }}</a>{% endfor %}</nav></details>
      <div class="languages">{% if lang == "en" %}<a href="{{ altUrl or '/es/' }}" hreflang="es">ES</a><span>/</span><strong aria-current="page">EN</strong>{% else %}<strong aria-current="page">ES</strong><span>/</span><a href="{{ altUrl or '/en/' }}" hreflang="en">EN</a>{% endif %}</div>
    </div>
  </header>
  <main id="main">{{ content | safe }}</main>
  <footer class="site-footer">
    <div class="footer-grid wrap">
      <div><div class="footer-brand">Panamensis</div><p>{{ site.description[lang] }}</p></div>
      <nav aria-label="{{ 'Footer navigation' if lang == 'en' else 'Navegación del pie' }}">
        <a href="/{{ lang }}/#collaborate">{{ "Contribute" if lang == "en" else "Contribuir" }}</a>
        <a href="/{{ lang }}/#collaborate">{{ "Contact" if lang == "en" else "Contacto" }}</a>
        <a href="/{{ lang }}/#about">{{ "Rights & licensing" if lang == "en" else "Derechos y licencias" }}</a>
      </nav>
    </div>
  </footer>
</body>
</html>
